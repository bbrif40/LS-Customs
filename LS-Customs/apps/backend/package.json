{
  "name": "@ls-customs/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase backend for LS Customs — schema, Edge Functions, seed data",
  "scripts": {
    "dev": "npx supabase start --yes && npx supabase functions serve --env-file supabase/.env",
    "db:start": "npx supabase start --yes",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:diff": "npx supabase db diff --linked",
    "db:lint": "npx supabase db lint",
    "db:types": "npx supabase gen types typescript --linked > ../../packages/shared-types/src/database.types.ts",
    "functions:serve": "npx supabase functions serve --env-file supabase/.env",
    "functions:deploy": "npx supabase functions deploy",
    "precommit:check": "node scripts/check-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint supabase/functions/ --ext .ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@types/node": "^22.0.0",
    "supabase": "^2.115.0",
    "turbo": "^2.10.11",
    "typescript": "^5.6.0"
  }
}
