# LS Customs — Environment Variables Reference
#
# This file documents all required environment variables.
# Copy to `apps/backend/supabase/.env` for local development (git-ignored).
# For hosted: set via `supabase secrets set`.
#
# See DOCUMENTATION.md §4 for full instructions.

# --- Supabase connection ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payment Provider ---
# Set to "PAYMONGO" or "STRIPE" to select the active provider
PAYMENT_PROVIDER=PAYMONGO

# Shared fallback (used when provider-specific key is not set)
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
STRIPE_BASE_URL=http://host.docker.internal:8090

# PayMongo-specific (Philippines payment provider)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BASE_URL=http://host.docker.internal:8090

# Stripe-specific (backwards-compatible fallback)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=https://api.stripe.com

# --- Google OAuth ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Google Maps (geocoding) ---
GOOGLE_MAPS_API_KEY=

# --- AI Chatbot (customer support via OpenRouter) ---
# OpenRouter API key — get one at https://openrouter.ai/keys
# Supports free models (e.g., deepseek-coder, microsoft/phi-3, etc.)
# WARNING: if any previous key was ever committed to git or pasted into chat,
# ROTATE IT at https://openrouter.ai/keys before using a new one. Treat any
# leaked key as permanently compromised.
OPENROUTER_API_KEY=
# Optional: override the API base URL (e.g., for self-hosted OpenAI-compatible endpoints)
# OPENROUTER_BASE_URL=

# --- Email notifications (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ls-customs.ph

# --- SMS notifications (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Client-safe (Ionic app / Vercel) — safe to expose to browser bundle ---
# Copy SUPABASE_URL and SUPABASE_ANON_KEY above to `.env.local` for the frontend.
