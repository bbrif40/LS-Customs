{
  "name": "ls-customs",
  "private": true,
  "version": "0.1.0",
  "description": "LS Customs — car-rental + mobile-mechanic marketplace backend",
  "workspaces": [
    "apps/backend",
    "apps/web",
    "packages/shared-types",
    "packages/config"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "supabase": "^2.115.0",
    "turbo": "^2.1.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath LS-Customs/.githooks",
    "dev": "npm run db:start --workspace=apps/backend && concurrently --names \"FNS,WEB\" --prefix-colors \"cyan,magenta\" \"npm run functions:serve --workspace=apps/backend\" \"npm run dev --workspace=apps/web\"",
    "web:dev": "npm run db:start && npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "db:start": "npm run db:start --workspace=apps/backend",
    "db:stop": "npm run db:stop --workspace=apps/backend",
    "db:reset": "npm run db:reset --workspace=apps/backend",
    "db:push": "npm run db:push --workspace=apps/backend",
    "db:diff": "npm run db:diff --workspace=apps/backend",
    "db:lint": "npm run db:lint --workspace=apps/backend",
    "db:types": "npm run db:types --workspace=apps/backend",
    "functions:serve": "npm run functions:serve --workspace=apps/backend",
    "functions:deploy": "npm run functions:deploy --workspace=apps/backend",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  }
}
